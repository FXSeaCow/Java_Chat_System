# Copy to config.properties and fill in your Supabase connection details.
# config.properties is ignored by Git. Never put credentials in the client.

# TCP server and client connection
server.host=127.0.0.1
server.port=8080

# Supabase Dashboard > Connect > Direct connection or Session pooler.
# Keep the JDBC prefix, host, port and database name. Use port 5432 for
# Direct/Session mode. The pooler username is postgres.<project-ref>.
# sslmode=require encrypts the connection. For certificate verification,
# download the Supabase certificate and use sslmode=verify-full&sslrootcert=PATH.
database.url=jdbc:postgresql://YOUR_HOST:5432/postgres?sslmode=require
database.username=YOUR_DATABASE_USERNAME
database.password=

# Optional AI integration; leave blank until a provider is configured.
ai.api_url=
ai.api_key=
ai.model=
